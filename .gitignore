# Dependencies
node_modules/
dashboard/app/node_modules/

# Frontend build tooling. The *built* output in dashboard/static is intentionally
# TRACKED (see below) so the console runs with no build step; only the intermediate
# Vite output is ignored.
dashboard/app/dist/

# Memkeel runtime state and backups. These are user data:
#   state/    - index, consumption checkpoint, access log, hook queue, locks
#   backups/  - pre-write backups of replaced notes and host configs
# Never commit them, and never point a test fixture at the real memory home.
state/
backups/

# Lock files (writer locks, package manager locks for the dashboard app are tracked)
*.lock
!dashboard/app/package-lock.json

# Secrets and local environment
.env
.env.*

# Compressed session archives produced by some hosts
*.zstd

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS junk
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editor and IDE junk
.idea/
.vscode/
*.swp
*.swo
*~
*.orig
*.rej

# Do NOT ignore dashboard/static/ - the committed production bundle is a feature.
